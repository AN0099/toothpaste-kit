# CLASSIFIED/ must never be tracked or pushed to the public repo.
# Kept here as a backstop even though CLASSIFIED/ lives outside this repo's working tree entirely.
CLASSIFIED/

# Local editor/OS noise
.DS_Store
Thumbs.db
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Local environment and secrets
.env
*.env.local

# Regenerable index/cache data, not canonical
*.db
index/

# Editor workspace files, personal, not shared config
*.code-workspace

# Repomix pack artifacts, never commit and never re-pack a pack
repomix-output.*
.repomixignore
.temp-secrets
