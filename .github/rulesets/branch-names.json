{
  "name": "branch-names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 29110, "actor_type": "Integration", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/feat/*",
        "refs/heads/fix/*",
        "refs/heads/docs/*",
        "refs/heads/chore/*",
        "refs/heads/sync/*",
        "refs/heads/acmm/*",
        "refs/heads/record/*",
        "refs/heads/ci/*",
        "refs/heads/quality/*",
        "refs/heads/skills/*",
        "refs/heads/scripts/*",
        "refs/heads/release/*",
        "refs/heads/test/*",
        "refs/heads/licence/*"
      ]
    }
  },
  "rules": [
    { "type": "creation" }
  ]
}
