# Reject AI attribution trailers in commit messages. The commit-attribution
# workflow runs this same file on every commit in a pull request.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# This is a convenience, not the enforcement. Hooks do not travel with a clone
# and `--no-verify` bypasses them. The binding check is the required status
# check on the default branch. See CONTRIBUTING.md.

msg_file="$1"

# Extended regex, read case-insensitively. Assisted-by and the Agent-*
# trailers are provenance trailers some tools write; tests/attribution-cases.tsv
# holds the cases gate 14 in scripts/gates.sh runs this hook against.
pattern='^Co-Authored-By[[:space:]]*:.*(Claude|Anthropic)|^Claude-Session[[:space:]]*:|Generated with .*Claude|^Assisted-by[[:space:]]*:|^Agent-[A-Za-z-]+[[:space:]]*:'

if grep -qiE "$pattern" "$msg_file"; then
    echo "commit-msg: rejected, AI attribution trailer found." >&2
    echo >&2
    grep -niE "$pattern" "$msg_file" >&2
    echo >&2
    echo "This repository does not carry tool attribution in commit messages." >&2
    echo "Remove the lines above and commit again." >&2
    exit 1
fi

exit 0
