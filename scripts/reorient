#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Aidan Naveja
#
# SPDX-License-Identifier: Apache-2.0

# reorient: the cheapest true statement of where a workspace stands.
#
# The observing half of the `orient` skill. Run it at the start of a session
# and after every compaction, so the budget is the design constraint: one
# screen of output, no file contents, no analysis. It prints state and ranks
# nothing, verifies no claim and runs no gate. The COVERAGE block at the end
# names what it read and what it did not, because a report that does not state
# its scope reads as a clean result.
#
# Usage: reorient [--fetch] [--wide] [ROOT]
#        reorient --selftest
#   ROOT     the workspace; default the current directory
#   --fetch  update remote refs first (network)
#   --wide   name every changed file instead of the first three
#
# Paths come from the workspace itself, so nothing here names one desk:
#   provenance layer  the `provenance layer is `PATH`` line in ROOT/CLAUDE.md,
#                     default .agents/context
#   manifest          the `listed in `PATH`` line in ROOT/CLAUDE.md, default
#                     index.md; its "Ensure These are Up-to-Date" list is the
#                     standing-files set
#   queues            standing files whose name contains `queue` and ends .json
#   flag register     the standing file whose name contains `flagged`
# Repositories read: ROOT itself, ROOT/projects/*, and any in REORIENT_REPOS
# (colon-separated paths). A path there that is not a repository gets a
# "not a repository" line, so a skipped tree is never silent.
#
# Env:
#   REORIENT_INBOX_REPO  a repository whose sibling branches deliver mail into
#                        inbox-<branch>/. Unset, the MAIL section is off.
#   REORIENT_FG_LIMIT    seconds; a harness shell older than this is reported.
#                        Default 180, just over Claude Code's tool timeout.
#   REORIENT_PS          the process lister, default ps. Without one, TASK says
#                        it did not check rather than reporting no shells.
set -u
HERE=$(cd "$(dirname "$0")" && pwd)

selftest() {
  local tmp out fails=0 pid
  tmp=$(mktemp -d) || return 1
  trap 'rm -rf -- "${tmp:?}"' RETURN
  cp -R "$HERE/../examples/workspace/." "$tmp/" || return 1
  mkdir -p "$tmp/.agents/context" || return 1  # an empty directory may not survive a copy
  check() { # $1 label, $2 pattern expected (or !pattern for absent)
    case "$2" in
      !*) if printf '%s\n' "$out" | grep -qE -- "${2#!}"; then echo "FAIL $1"; fails=$((fails+1)); else echo "ok   $1"; fi ;;
      *)  if printf '%s\n' "$out" | grep -qE -- "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails+1)); fi ;;
    esac
  }
  # The second tree: the kit's own example workspace, untouched.
  out=$(bash "$0" "$tmp" 2>&1); rc=$?
  [ "$rc" -eq 0 ] && echo "ok   exits 0 on the example workspace" || { echo "FAIL exit $rc"; fails=$((fails+1)); }
  check "standing set read from the manifest"   '^STANDING 5 files, 0 over a week old, 0 defective'
  check "queue found through the manifest"      '^QUEUE task-queue +0 tasks$'
  check "no capture reported as none"           '^CAP  no session-\[0-9\]\*\.md in '
  check "flag register without Open says so"    '^FLAG threads-flagged.md has no Open section'
  check "mail off by default"                   '!^MAIL'
  check "coverage block present"                '^COVERAGE:'
  check "root that is not a repository named"  "^GIT  $(basename "$tmp") +not a repository$"
  # Planted positives: each must change the line it targets.
  printf '# Session\n\n## 10:00 first: x\n\n## 10:05 [jot] y\n' > "$tmp/.agents/context/session-2026-01-01-plant.md"
  rm "$tmp/.agents/lead-handoff.md"
  printf '{"tasks":[{"id":"T-1","status":"pending"}]}\n' > "$tmp/.agents/task-queue.json"
  printf '# Flags\n\n## Open\n\n### 2026-01-01\n\n<!--flag-->\n**A flag**\n\n## Resolved\n\n<!--flag-->\n' > "$tmp/.agents/threads-flagged.md"
  sed 's|provenance layer is `.agents/context/`|provenance layer is `.agents/elsewhere/`|' "$tmp/CLAUDE.md" > "$tmp/CLAUDE.md.new" && mv "$tmp/CLAUDE.md.new" "$tmp/CLAUDE.md"
  mkdir -p "$tmp/.agents/elsewhere" && mv "$tmp/.agents/context/session-2026-01-01-plant.md" "$tmp/.agents/elsewhere/"
  printf '# Runbook\n\n## 11:00 not a capture\n' > "$tmp/.agents/elsewhere/session-end-runbook.md"
  # Known limit: from 2036 the plant capture is newer than this stamp. The plant still bites without it.
  touch -t 203512312359 "$tmp/.agents/elsewhere/session-end-runbook.md"
  # R3: an inbox with one note on a sibling branch.
  git init -q -b dt "$tmp/inbox" && mkdir "$tmp/inbox/inbox-dt" && : > "$tmp/inbox/inbox-dt/.keep" &&
    git -C "$tmp/inbox" add -A && git -C "$tmp/inbox" -c user.name=t -c user.email=t@t commit -qm base &&
    git -C "$tmp/inbox" switch -qc other && : > "$tmp/inbox/inbox-dt/note.md" &&
    git -C "$tmp/inbox" add -A && git -C "$tmp/inbox" -c user.name=t -c user.email=t@t commit -qm note &&
    git -C "$tmp/inbox" update-ref refs/remotes/origin/other other && git -C "$tmp/inbox" switch -q dt || return 1
  git -C "$tmp/inbox" update-ref refs/remotes/origin/dt other  # this seat's own branch is never mail
  bash -c 'sleep 20; :' shell-snapshots/snapshot-bash-plant.sh >/dev/null 2>&1 & pid=$!
  bash -c 'sleep 20; :' not-a-snapshot.sh >/dev/null 2>&1 & pid2=$!
  sleep 1
  out=$(REORIENT_FG_LIMIT=0 REORIENT_INBOX_REPO="$tmp/inbox" bash "$0" "$tmp" 2>&1)
  kill "$pid" "$pid2" 2>/dev/null; wait "$pid" "$pid2" 2>/dev/null
  check "provenance path read from CLAUDE.md"   '^CAP  session-2026-01-01-plant.md  5 lines, 2 entries'
  check "partials counted"                      '^PART 1 log, 1 jot, 0 touch since the last close \(no close heading in this file\)$'
  check "missing standing file named"           'MISSING \.agents/lead-handoff\.md'
  check "missing standing file counted"         '^STANDING .*, 1 defective$'
  check "queue counts statuses"                 '^QUEUE task-queue +1 tasks: pending 1'
  check "marked flags counted"                  '^FLAG 1 date groups, 1 marked flags, <=1 unmarked bound'
  check "flag below Resolved reported"          'MISFILED 1 below Resolved, first at line 12$'
  check "runbook not read as the capture"       '^CAP  session-2026-01-01-plant\.md '
  check "mail on a sibling branch reported"     '^MAIL other +1 file\(s\) not in dt'
  check "mail found is not also reported none"  '!^MAIL none'
  check "own seat's branch not read as mail"     '!^MAIL dt '
  if command -v ps >/dev/null 2>&1; then
    check "old harness shell reported"          "^TASK pid $pid "
    check "old process without a snapshot not reported" "!^TASK pid $pid2 "
  else
    echo "skip old harness shell reported: no ps on this host, so it cannot be planted"
  fi
  # An inbox with nothing waiting says so, and a missing inbox says it was not read.
  git -C "$tmp/inbox" update-ref refs/remotes/origin/other dt
  out=$(REORIENT_INBOX_REPO="$tmp/inbox" bash "$0" "$tmp" 2>&1)
  check "empty inbox reported as none"          '^MAIL none: no new file in inbox-dt on any sibling'
  out=$(REORIENT_INBOX_REPO="$tmp/inbox/inbox-dt" bash "$0" "$tmp" 2>&1)
  check "inbox not a repository reported"      '^MAIL not read: .*inbox-dt is not a repository'
  git -C "$tmp/inbox" switch -qc nobox
  out=$(REORIENT_INBOX_REPO="$tmp/inbox" bash "$0" "$tmp" 2>&1)
  check "missing inbox directory reported"      '^MAIL not read: .* has no inbox-nobox/'
  git -C "$tmp/inbox" switch -q dt
  # A project directory that is not a repository is named, not skipped.
  mkdir -p "$tmp/projects/plain"
  out=$(bash "$0" "$tmp" 2>&1)
  check "project not a repository named"       '^GIT  plain +not a repository$'
  # TK-112: with no process lister, TASK says so instead of reporting no shells.
  out=$(REORIENT_PS=reorient-no-such-ps bash "$0" "$tmp" 2>&1)
  check "missing ps says not checked"           '^TASK not checked: reorient-no-such-ps not found'
  check "missing ps is not read as no shells"   '!^TASK no harness shell'
  # A malformed age from ps skips the row instead of reading as 0; the good row proves the fake is read.
  # The fake also gives every pid the parent 4244, so 4244 is this script's own ancestry.
  cat > "$tmp/fake-ps" <<'FAKE'
#!/bin/sh
case "$1" in
  -eo)
    echo "4242 7- bash -c x shell-snapshots/snapshot-bash-9.sh"
    echo "4243 10:00 bash -c y shell-snapshots/snapshot-bash-9.sh"
    echo "4244 99:00 bash -c anc shell-snapshots/snapshot-bash-9.sh"
    echo "4245 1-01:02:03 bash -c shell-snapshots/snapshot-bash-9.sh && eval 'cmdx' < /dev/null && pwd"
    echo "4246 02:59 bash -c young shell-snapshots/snapshot-bash-9.sh"
    echo "4247 03:00 bash -c limit shell-snapshots/snapshot-bash-9.sh" ;;
  -o) if [ "$4" = 4244 ]; then echo 1; else echo 4244; fi ;;
  *) exec ps "$@" ;;
esac
FAKE
  chmod +x "$tmp/fake-ps"
  out=$(REORIENT_FG_LIMIT=0 REORIENT_PS="$tmp/fake-ps" bash "$0" "$tmp" 2>&1)
  check "malformed process age skipped"        '!^TASK pid 4242 '
  check "fake ps read: well-formed row reported" '^TASK pid 4243 '
  check "mm:ss age read minutes first"          '^TASK pid 4243 +age +10m '
  check "own ancestry not reported"             '!^TASK pid 4244 '
  check "dd-hh:mm:ss age and eval command"      '^TASK pid 4245 +age 1502m  cmdx$'
  out=$(REORIENT_PS="$tmp/fake-ps" bash "$0" "$tmp" 2>&1)
  check "default limit: 179s not reported"      '!^TASK pid 4246 '
  check "default limit: 180s reported"          '^TASK pid 4247 '
  # Captures: each close form resets the counts; the newest by mtime is read, not by name.
  printf '# S\n\n## 09:00 a\n\n## session-close run\n\n## 09:30 b\n\n## Close, 2026-01-01\n\n## 10:00 c\n\n## 12:00 PDT, session-close\n\n## 13:00 [touch] z\n' > "$tmp/.agents/elsewhere/session-2025-12-31-close.md"
  touch -t 203001010000 "$tmp/.agents/elsewhere/session-2025-12-31-close.md"
  # Flags: a date group below Resolved is misfiled and not counted in Open.
  printf '# Flags\n\n## Open\n\n### 2026-01-02\n\n<!--flag-->\n**F**\n\n## Resolved\n\n### 2025-12-01\n' > "$tmp/.agents/threads-flagged.md"
  python3 -c 'import os,sys,time; t=time.time()-10*86400; os.utime(sys.argv[1],(t,t))' "$tmp/.agents/task-queue.json"
  # Repositories: names cut after three, the overflow count, a worktree's .git file,
  # detached HEAD, no upstream, ahead and behind, and the REORIENT_REPOS list.
  r="$tmp/projects/r"
  { git init -q -b base "$r" && mkdir "$r/sub" && for f in d1 d2 d3 d4; do : > "$r/$f"; done &&
    git -C "$r" add -A && git -C "$r" -c user.name=t -c user.email=t@t commit -qm c1 &&
    git -C "$r" switch -qc work && git -C "$r" -c user.name=t -c user.email=t@t commit -q --allow-empty -m c2 &&
    git -C "$r" -c user.name=t -c user.email=t@t commit -q --allow-empty -m c3 &&
    git -C "$r" switch -q base && git -C "$r" -c user.name=t -c user.email=t@t commit -q --allow-empty -m c4 &&
    git -C "$r" switch -q work && git -C "$r" branch -q -u base &&
    git -C "$r" worktree add -q --detach "$tmp/projects/wt" && : > "$tmp/projects/wt/w1" &&
    for f in d1 d2 d3 d4; do echo x > "$r/$f"; done && : > "$r/s1" && git -C "$r" add s1 &&
    : > "$r/sub/u1" && : > "$r/sub/u2" && : > "$r/sub/u3"; } || return 1
  : > "$tmp/projects/file.txt"
  out=$(REORIENT_REPOS=":$tmp/inbox" bash "$0" "$tmp" 2>&1)
  check "HH:MM TZ, session-close resets counts"  '^PART 0 log, 0 jot, 1 touch since the last close$'
  check "last entry is the newest heading"      '^LAST 13:00 \[touch\] z$'
  check "newest capture by mtime, not name"     '^CAP  session-2025-12-31-close\.md '
  check "date group below Resolved misfiled"    'MISFILED 1 below Resolved, first at line 12$'
  check "date groups counted in Open only"      '^FLAG 1 date groups, 1 marked flags'
  check "ten-day-old standing file counted"     '^STANDING .*, 1 over a week old, '
  check "ahead and behind the upstream"         '^GIT  r .* work +staged 1 +dirty 4 +untracked 3 +ahead 2 behind 1$'
  check "names: four cut to three and +1"       '^      staged: s1 dirty: d1 d2 d3 \+1 new: u1 u2 u3$'
  check "worktree read, detached, no upstream"  '^GIT  wt .* detached@[0-9a-f]+ .* ahead - behind -$'
  check "names line for untracked only"         '^      new: w1$'
  check "file under projects is not a repo"     '!^GIT  file\.txt'
  check "REORIENT_REPOS repository read"        '^GIT  inbox '
  check "empty REORIENT_REPOS element skipped"  '!^GIT  +not a repository$'
  for h in 'Close, 2026-01-01' 'session-close run'; do  # only the newest close counts, so one form per run
    printf '# S\n\n## 09:00 a\n\n## %s\n\n## 13:00 [touch] z\n' "$h" > "$tmp/.agents/elsewhere/session-2025-12-31-close.md"
    touch -t 203001010000 "$tmp/.agents/elsewhere/session-2025-12-31-close.md"
    out=$(bash "$0" "$tmp" 2>&1)
    check "close heading '$h' resets the counts" '^PART 0 log, 0 jot, 1 touch since the last close$'
  done
  out=$(bash "$0" --wide "$tmp" 2>&1)
  check "--wide names every file"               ' dirty: d1 d2 d3 d4 new:'
  # A workspace with no CLAUDE.md, no provenance layer and no manifest uses and names the defaults.
  mkdir "$tmp/bare"
  out=$(bash "$0" "$tmp/bare" 2>&1)
  check "default provenance layer named"        '^CAP  provenance layer \.agents/context not found$'
  check "default manifest named"                '^STANDING no manifest at index\.md$'
  # PIN reads the user settings; an alias and a null env are not errors.
  mkdir -p "$tmp/home/.claude"
  printf '{"model": "opus", "env": null}\n' > "$tmp/home/.claude/settings.json"
  out=$(HOME="$tmp/home" bash "$0" "$tmp/bare" 2>&1)
  check "PIN alias, null env, autoupdate on"    '^PIN  model opus \(ALIAS\)  claude-code .*  autoupdate ON$'
  printf '{"model": "claude-x-4", "env": {"DISABLE_AUTOUPDATER": "1"}}\n' > "$tmp/home/.claude/settings.json"
  out=$(HOME="$tmp/home" bash "$0" "$tmp/bare" 2>&1)
  check "PIN pinned, autoupdate off"            '^PIN  model claude-x-4 \(pinned\)  claude-code .*  autoupdate off$'
  [ "$fails" -eq 0 ] && { echo "reorient: selftest passed"; return 0; }
  echo "reorient: selftest FAILED ($fails)"; return 1
}

do_fetch=0; wide=0; ROOT=.
for a in "$@"; do
  case "$a" in
    --selftest) selftest; exit $? ;;
    --fetch) do_fetch=1 ;;
    --wide)  wide=1 ;;
    -*) printf 'reorient: unknown argument %s\n' "$a" >&2; exit 2 ;;
    *)  ROOT=$a ;;
  esac
done
ROOT=$(cd "$ROOT" 2>/dev/null && pwd) || { printf 'reorient: no such directory\n' >&2; exit 2; }

# Paths from the workspace's own CLAUDE.md, with the example layout as default.
from_claude() { # $1 sed pattern capturing the path, $2 default
  local v=""
  [ -f "$ROOT/CLAUDE.md" ] && v=$(sed -nE "s/.*$1.*/\1/p" "$ROOT/CLAUDE.md" | head -1)
  printf '%s' "${v:-$2}"
}
CTX="$ROOT/$(from_claude 'provenance layer is `([^`]+)`' .agents/context)"; CTX=${CTX%/}
MAN="$ROOT/$(from_claude 'listed in `([^`]+)`' index.md)"

names() { # $1 count, rest: names
  local n="$1"; shift
  [ "$n" -eq 0 ] && return
  if [ "$wide" -eq 1 ] || [ "$n" -le 3 ]; then printf ' %s' "$@"
  else printf ' %s %s %s +%d' "$1" "$2" "$3" "$((n - 3))"; fi
}

repo() { # $1 label, $2 path
  local lab="$1" dir="$2" br staged dirty untr st ahead behind lvl
  if [ ! -d "$dir/.git" ] && [ ! -f "$dir/.git" ]; then
    printf 'GIT  %-14s not a repository\n' "$lab"; return 0
  fi
  [ "$do_fetch" -eq 1 ] && git -C "$dir" fetch --quiet 2>/dev/null
  lvl=$(bash "$HERE/remote-level.sh" "$dir" 2>/dev/null || printf 'external')
  br=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '?')
  [ "$br" = HEAD ] && br="detached@$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  staged=$(git -C "$dir" diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')
  dirty=$(git -C "$dir" diff --name-only 2>/dev/null | wc -l | tr -d ' ')
  untr=$(git -C "$dir" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')
  st=$(git -C "$dir" rev-list --left-right --count "@{u}...HEAD" 2>/dev/null || true)
  if [ -n "$st" ]; then behind=${st%%[!0-9]*}; ahead=${st##*[!0-9]}; else behind=-; ahead=-; fi
  printf 'GIT  %-14s %-9s %-10s staged %-3s dirty %-3s untracked %-3s ahead %s behind %s\n' \
    "$lab" "$lvl" "$br" "$staged" "$dirty" "$untr" "${ahead:-0}" "${behind:-0}"
  if [ "$((staged + dirty + untr))" -gt 0 ]; then
    printf '     '
    [ "$staged" -gt 0 ] && { printf ' staged:'; names "$staged" $(git -C "$dir" diff --cached --name-only | sed 's|.*/||'); }
    [ "$dirty"  -gt 0 ] && { printf ' dirty:';  names "$dirty"  $(git -C "$dir" diff --name-only | sed 's|.*/||'); }
    [ "$untr"   -gt 0 ] && { printf ' new:';    names "$untr"   $(git -C "$dir" ls-files --others --exclude-standard | sed 's|.*/||'); }
    printf '\n'
  fi
}

printf 'REORIENT %s  %s\n' "$(date '+%Y-%m-%d %H:%M %Z')" "$ROOT"

# Claude Code only: the model and harness version this seat asked for. Read
# from the user settings file, so it is what was requested, not what runs.
if [ -f "$HOME/.claude/settings.json" ]; then
  python3 - "$HOME/.claude/settings.json" "$(claude --version 2>/dev/null | cut -d' ' -f1)" <<'PY'
import json, re, sys
try: d = json.load(open(sys.argv[1]))
except Exception as e: print("PIN  user settings unreadable:", e); raise SystemExit
m = d.get("model") or "(unset)"
kind = "pinned" if re.search(r"\d", m) else "ALIAS"
au = "off" if (d.get("env") or {}).get("DISABLE_AUTOUPDATER") else "ON"
print("PIN  model %s (%s)  claude-code %s  autoupdate %s" % (m, kind, sys.argv[2] or "?", au))
PY
fi

repo "$(basename "$ROOT")" "$ROOT"
for p in "$ROOT"/projects/*; do [ -d "$p" ] && repo "$(basename "$p")" "$p"; done
IFS=: read -r -a extra <<< "${REORIENT_REPOS:-}"
for p in ${extra[@]+"${extra[@]}"}; do [ -n "$p" ] && repo "$(basename "$p")" "$p"; done

# Mail, only where a file inbox is configured. Each sibling branch's files in
# inbox-<this branch>/ that this branch does not carry. Reachability measures
# delivery, not reading, so this is an upper bound on what is new.
IB="${REORIENT_INBOX_REPO:-}"
if [ -n "$IB" ] && [ -d "$IB/.git" ]; then
  seat=$(git -C "$IB" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '')
  box="inbox-$seat"
  if [ -d "$IB/$box" ]; then
    mail=0
    for ref in $(git -C "$IB" for-each-ref --format='%(refname:short)' refs/remotes/origin 2>/dev/null); do
      case "$ref" in origin/HEAD|"origin/$seat") continue ;; esac
      # Three-dot and added-or-modified only: two-dot compares the tips and
      # counts this branch's own notes as mail waiting.
      files=$(git -C "$IB" diff --name-only --diff-filter=AM "HEAD...$ref" -- "$box/" 2>/dev/null | sed 's|.*/||' | sort -r)
      n=$(printf '%s' "$files" | grep -c . || true)
      [ "${n:-0}" -gt 0 ] && printf 'MAIL %-8s %s file(s) not in %s:%s\n' "${ref#origin/}" "$n" "$seat" "$(names "$n" $files)"
      mail=$((mail + ${n:-0}))
    done
    [ "$mail" -eq 0 ] && printf 'MAIL none: no new file in %s on any sibling branch\n' "$box"
  else
    printf 'MAIL not read: %s has no %s/\n' "$IB" "$box"
  fi
elif [ -n "$IB" ]; then
  printf 'MAIL not read: %s is not a repository\n' "$IB"
fi

# Claude Code only: harness shells older than the foreground limit. Every
# harness Bash call runs as a shell sourcing shell-snapshots/snapshot-<shell>-*,
# foreground and background alike, so age is what separates them: a foreground
# call is bounded by the tool timeout. This script's own ancestry is excluded.
FG=${REORIENT_FG_LIMIT:-180}
PS=${REORIENT_PS:-ps}
Q="'"
if ! command -v "$PS" >/dev/null 2>&1; then
  printf 'TASK not checked: %s not found, so harness shells were not read\n' "$PS"
else
chain=" $$ "
p=$("$PS" -o ppid= -p $$ 2>/dev/null | tr -d ' ')
while [ -n "${p:-}" ] && [ "$p" != 1 ]; do chain="$chain$p "; p=$("$PS" -o ppid= -p "$p" 2>/dev/null | tr -d ' '); done
# ps etime is [[dd-]hh:]mm:ss on GNU and BSD; etimes is GNU only.
etime_secs() {
  local t=$1 d=0 h=0 m=0 s=0
  case "$t" in *-*) d=${t%%-*}; t=${t#*-} ;; esac
  case "$t" in
    *:*:*) h=${t%%:*}; t=${t#*:}; m=${t%%:*}; s=${t#*:} ;;
    *:*)   m=${t%%:*}; s=${t#*:} ;;
    *)     s=$t ;;
  esac
  # bash 3.2 reads an empty 10# as 0, so check the fields rather than rely on the error.
  for v in "$d" "$h" "$m" "$s"; do case "$v" in (''|*[!0-9]*) return 1 ;; esac; done
  echo $(( 10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s ))
}
tasks=$("$PS" -eo pid=,etime=,args= 2>/dev/null | while read -r pid et rest; do
  case "$rest"  in (*shell-snapshots/snapshot-*) ;; (*) continue ;; esac
  case "$chain" in (*" $pid "*) continue ;; esac
  secs=$(etime_secs "$et" 2>/dev/null)
  case "$secs" in (''|*[!0-9]*) continue ;; esac
  [ "$secs" -lt "$FG" ] && continue
  cmd=${rest#*eval $Q}; cmd=${cmd%%$Q < /dev/null*}
  printf 'TASK pid %-7s age %4dm  %.60s\n' "$pid" "$((secs / 60))" "$cmd"
done)
if [ -n "$tasks" ]; then printf '%s\n' "$tasks"; else printf 'TASK no harness shell older than %ss\n' "$FG"; fi
fi

# Newest capture by mtime. A capture is named for the date it covers, so the
# glob requires a digit after `session-`; without it a runbook named
# session-end-... read as the newest capture. An entry is a `# Entry` heading
# or a `## ` heading carrying an HH:MM time.
capglob="session-[0-9]*.md"
if [ -d "$CTX" ]; then
  cap=$(ls -t "$CTX"/$capglob 2>/dev/null | head -1)
  if [ -n "${cap:-}" ]; then
    ents=$(grep -cE '^(# Entry|## .*[0-2][0-9]:[0-5][0-9])' "$cap" 2>/dev/null) || ents=${ents:-0}
    last=$(grep -E '^(# Entry|## .*[0-2][0-9]:[0-5][0-9])' "$cap" 2>/dev/null | tail -1 | sed 's/^#* *//')
    printf 'CAP  %s  %s lines, %s entries\n' "$(basename "$cap")" "$(wc -l < "$cap" | tr -d ' ')" "${ents:-0}"
    printf 'LAST %s\n' "${last:-(no entry heading: # Entry, or ## with an HH:MM time)}"
    # Partial captures (docs/partial-captures.md) since the newest close. A
    # close heading contains `session-close run`, starts `## Close,`, or reads
    # `## HH:MM [TZ], session-close`. Every other timed `## ` heading is a
    # session-log entry, also residue a close has not processed.
    awk '
      /^## / && (/session-close run/ || /^## Close,/ ||
                 /^## [0-2][0-9]:[0-5][0-9]( [A-Z][A-Z]+)?, session-close( |\(|$)/) { j = 0; t = 0; l = 0; seen = 1; next }
      /^## / && /\[jot\]/   { j++; next }
      /^## / && /\[touch\]/ { t++; next }
      /^## .*[0-2][0-9]:[0-5][0-9]/ { l++ }
      END { printf "PART %d log, %d jot, %d touch since the last close%s\n", l, j, t,
                   seen ? "" : " (no close heading in this file)" }' "$cap"
  else
    printf 'CAP  no %s in %s\n' "$capglob" "${CTX#$ROOT/}"
  fi
else
  printf 'CAP  provenance layer %s not found\n' "${CTX#$ROOT/}"
fi

# The standing set, parsed from the manifest so this cannot disagree with it.
# Queues and the flag register are found in that same list.
[ -f "$MAN" ] && python3 - "$MAN" "$ROOT" <<'PY'
import sys, os, re, time, json, collections
man, root = sys.argv[1], sys.argv[2]
lines = open(man).read().split("\n")
try:
    a = next(i for i, l in enumerate(lines) if l.startswith("## Ensure These are Up-to-Date"))
except StopIteration:
    print("STANDING manifest has no up-to-date section"); raise SystemExit
rels = []
for l in lines[a + 1:]:
    if l.startswith("## "): break
    m = re.match(r"\s*-\s*`([^`]+)`", l)
    if m: rels.append(m.group(1))
for rel in rels:
    base = os.path.basename(rel)
    if "queue" in base and base.endswith(".json"):
        label = base[:-5]
        try: d = json.load(open(os.path.join(root, rel)))
        except Exception as e: print("QUEUE %s unreadable: %s" % (label, e)); continue
        t = d.get("tasks", d) if isinstance(d, dict) else d
        c = collections.Counter(x.get("status", "(no status)") for x in t)
        print("QUEUE %s %d tasks%s" % (label, len(t), (": " + "  ".join("%s %d" % kv for kv in sorted(c.items()))) if t else ""))
for rel in rels:
    if "flagged" not in os.path.basename(rel): continue
    p = os.path.join(root, rel)
    if not os.path.exists(p): continue
    L = open(p).read().split("\n")
    try:
        s = next(i for i, l in enumerate(L) if l.startswith("## Open"))
        e = next(i for i, l in enumerate(L) if l.startswith("## Resolved"))
    except StopIteration:
        print("FLAG %s has no Open section" % os.path.basename(rel)); continue
    sec = L[s:e]
    # Marked flags are exact; bold at column 0 is the upper bound that also
    # covers entries written before the marker.
    print("FLAG %d date groups, %d marked flags, <=%d unmarked bound in Open"
          % (sum(l.startswith("### ") for l in sec), sum(l == "<!--flag-->" for l in sec),
             sum(l.startswith("**") for l in sec)))
    mis = [e + i + 1 for i, l in enumerate(L[e:]) if l == "<!--flag-->" or l.startswith("### ")]
    if mis: print("     MISFILED %d below Resolved, first at line %d" % (len(mis), mis[0]))
out, now, stale, bad = [], time.time(), 0, 0
for rel in rels:
    p = os.path.join(root, rel)
    if not os.path.exists(p):
        out.append("MISSING " + rel); bad += 1; continue
    d = int((now - os.path.getmtime(p)) // 86400)
    stale += d >= 7
    out.append("%4dd %s" % (d, rel))
print("STANDING %d files, %d over a week old, %d defective" % (len(out), stale, bad))
for o in out: print("      " + o)
PY
[ -f "$MAN" ] || printf 'STANDING no manifest at %s\n' "${MAN#$ROOT/}"

printf 'COVERAGE: git state for the workspace, projects/* and REORIENT_REPOS, with\n'
printf '          the level scripts/remote-level.sh assigns, and a line naming\n'
printf '          each of those paths that is not a repository; MAIL only when\n'
printf '          REORIENT_INBOX_REPO is set%s, saying none or not read\n' "$([ -n "$IB" ] && printf ' (set)' || printf ' (unset, not read)')"
printf '          rather than nothing; harness shells older\n'
printf '          than the foreground limit (Claude Code only; elsewhere TASK finds\n'
printf '          nothing and that is not a clean result; without ps it says not\n'
printf '          checked); PIN (Claude Code user settings only, what was\n'
printf '          asked for, not what runs); the newest capture and its partials;\n'
printf '          queues, flags and standing files found through the manifest.\n'
printf '          Does not run any gate, verify any claim, judge whether a document\n'
printf '          is current, or fetch unless asked. STANDING reads mtime, which says\n'
printf '          when a file was written, never whether it is still true. PART\n'
printf '          counts the newest capture file only.\n'
