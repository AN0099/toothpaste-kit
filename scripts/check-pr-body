"""Check a pull request body against .github/pull_request_template.md.

usage: scripts/check-pr-body BODY_FILE
       scripts/check-pr-body --event      read the body from $GITHUB_EVENT_PATH
       scripts/check-pr-body --selftest

Fails (exit 1) on any of:
  heading     a template heading missing, or headings out of order
  comment     a template <!-- comment --> left in the body
  provenance  the box under "Drafted with an agent?" ticked and no filled
              Provenance section, when the template has one

The template is read on every run, so the check follows it. Headings inside
code fences do not count, and neither does a Provenance section holding only
comments or empty code fences. It does NOT check the boxes, that a Provenance
line matches the commits, or anything about the prose, line wrapping included.
The pr-body job in CI is advisory: no ruleset requires it.
"""

import contextlib
import io
import json
import os
import pathlib
import re
import sys
import tempfile

TEMPLATE = pathlib.Path(__file__).resolve().parent.parent / ".github/pull_request_template.md"
PROVENANCE = re.compile(
    r"<details>\s*<summary>Provenance</summary>(.*?)</details>", re.S)
YES_TICKED = re.compile(r"^- \[[xX]\] Yes\b", re.M)

def strip_comments(text):
    return re.sub(r"<!--.*?-->", "", text, flags=re.S)


def strip_empty_fences(text):
    # A fence holding only blank lines is a placeholder, not content.
    return re.sub(r"^```[^\n]*\n(?:[ \t]*\n)*```[ \t]*$", "", text, flags=re.M)


def headings(text):
    out, fence = [], False
    for line in text.splitlines():
        if line.startswith("```"):
            fence = not fence
        elif not fence and re.match(r"^#{1,6} ", line):
            out.append(line.strip())
    return out


def check(body, template):
    found = []
    have, pos = headings(body), 0
    for h in headings(strip_comments(template)):
        try:
            pos = have.index(h, pos) + 1
        except ValueError:
            found.append(f"heading: missing or out of order: {h}")
    if "<!--" in body:
        found.append("comment: a template comment is still in the body")
    if PROVENANCE.search(template) and YES_TICKED.search(body):
        m = PROVENANCE.search(body)
        if not m or not strip_empty_fences(strip_comments(m.group(1))).strip():
            found.append("provenance: Yes is ticked and the Provenance section is missing or empty")
    return found


def selftest():
    template = ("# What this changes\n\n<!-- say it -->\n\n## Checks\n\n"
                "```sh\n# not a heading\n```\n\n## Drafted with an agent?\n\n"
                "- [ ] Yes\n\n<details>\n<summary>Provenance</summary>\n\n"
                "<!-- trailers -->\n\n</details>\n")
    prov = "\n\n<details>\n<summary>Provenance</summary>\n\nAssisted-by: m via t/1\n\n</details>\n"
    good = "# What this changes\n\nOne line.\n\n## Checks\n\n- [x] done\n\n## Drafted with an agent?\n\n"
    cases = [
        ("clean, agent", good + "- [x] Yes" + prov, set()),
        ("clean, no agent", good + "No.\n", set()),
        ("missing heading", "# What this changes\n\nText.\n", {"heading"}),
        ("out of order", "## Checks\n\n# What this changes\n\n## Drafted with an agent?\n", {"heading"}),
        ("comment left", good + "No.\n\n<!-- left -->\n", {"comment"}),
        ("agent box left empty", good + "- [ ] Yes\n", set()),
        ("no provenance", good + "- [x] Yes\n", {"provenance"}),
        ("empty provenance", good + "- [x] Yes\n\n<details>\n<summary>Provenance</summary>\n\n</details>\n",
         {"provenance"}),
    ]
    # A template whose comment holds a heading, with a deeper heading, and a
    # "#" line that is not a heading.
    deep = ("# What this changes\n\n<!--\n## Not required\n-->\n\n#5 is not a heading\n\n"
            "### Deep\n")
    cases += [
        ("heading trailing space", good.replace("## Checks\n", "## Checks  \n") + "No.\n", set()),
        ("capital X Yes", good + "- [X] Yes\n", {"provenance"}),
        ("Yes not a word", good + "- [x] Yesterday\n", set()),
        ("comment-only provenance", good + "- [x] Yes\n\n<details>\n<summary>Provenance</summary>\n\n"
         "<!-- t -->\n\n</details>\n", {"comment", "provenance"}),
        ("empty-fence provenance", good + "- [x] Yes\n\n<details>\n<summary>Provenance</summary>\n\n"
         "```text\n```\n\n</details>\n", {"provenance"}),
        ("blank-line fence provenance", good + "- [x] Yes\n\n<details>\n<summary>Provenance</summary>\n\n"
         "```\n\n  \n```\n\n</details>\n", {"provenance"}),
        ("fenced trailers", good + "- [x] Yes\n\n<details>\n<summary>Provenance</summary>\n\n"
         "```text\nAssisted-by: m via t/1\n```\n\n</details>\n", set()),
        ("other details only", good + "- [x] Yes\n\n<details>\n<summary>Notes</summary>\n\nx\n\n</details>\n",
         {"provenance"}),
        ("deep template, met", "# What this changes\n\n### Deep\n", set(), deep),
        ("deep template, unmet", "# What this changes\n\n## Deep\n", {"heading"}, deep),
        ("no provenance in template", good + "- [x] Yes\n", set(), template.split("<details>")[0]),
    ]
    ok = True
    for name, body, want, *tpl in cases:
        got = {f.split(":")[0] for f in check(body, tpl[0] if tpl else template)}
        print(f"{'ok  ' if got == want else 'FAIL'}  {name}" + ("" if got == want else f": want {sorted(want)}, got {sorted(got)}"))
        ok = ok and got == want
    # The file paths main() uses, end to end, so the event reader is exercised too.
    with tempfile.TemporaryDirectory() as d:
        event = pathlib.Path(d) / "event.json"
        event.write_text(json.dumps({"pull_request": {"body": "# What this changes\n"}}))
        got = read_event(event)
        ok_event = got == "# What this changes\n"
        print(f"{'ok  ' if ok_event else 'FAIL'}  event body read")
        ok = ok and ok_event
        event.write_text(json.dumps({"pull_request": {"body": None}}))
        ok_null = read_event(event) == ""
        print(f"{'ok  ' if ok_null else 'FAIL'}  event body null")
        ok = ok and ok_null
        # main() on a body file: the exit code follows the findings.
        global TEMPLATE
        saved, TEMPLATE = TEMPLATE, pathlib.Path(d) / "template.md"
        TEMPLATE.write_text(template)
        rcs = []
        for body in (good + "No.\n", good + "- [x] Yes\n"):
            (pathlib.Path(d) / "body.md").write_text(body)
            with contextlib.redirect_stdout(io.StringIO()):
                rcs.append(main([str(pathlib.Path(d) / "body.md")]))
        # --event reads the event file, and an unknown argument prints usage.
        event.write_text(json.dumps({"pull_request": {"body": good + "No.\n"}}))
        saved_env = os.environ.get("GITHUB_EVENT_PATH")
        os.environ["GITHUB_EVENT_PATH"] = str(event)
        with contextlib.redirect_stdout(io.StringIO()):
            rcs += [main(["--event"]), main(["--bogus"])]
        if saved_env is None:
            os.environ.pop("GITHUB_EVENT_PATH")
        else:
            os.environ["GITHUB_EVENT_PATH"] = saved_env
        TEMPLATE = saved
        ok_main = rcs == [0, 1, 0, 2]
        print(f"{'ok  ' if ok_main else 'FAIL'}  main exit codes" + ("" if ok_main else f": got {rcs}"))
        ok = ok and ok_main
        # The template is found from the script's own tree, whatever the working directory.
        saved_cwd = os.getcwd()
        os.chdir(d)
        try:
            ok_cwd = TEMPLATE.is_file()
        finally:
            os.chdir(saved_cwd)
        print(f"{'ok  ' if ok_cwd else 'FAIL'}  template found from another directory")
        ok = ok and ok_cwd
    print("check-pr-body selftest:", "passed" if ok else "FAILED")
    return 0 if ok else 1


def read_event(path):
    return json.loads(pathlib.Path(path).read_text())["pull_request"].get("body") or ""


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    if argv == ["--event"]:
        body = read_event(os.environ["GITHUB_EVENT_PATH"])
    elif len(argv) == 1 and not argv[0].startswith("-"):
        body = pathlib.Path(argv[0]).read_text()
    else:
        print(__doc__.strip())
        return 2
    found = check(body.replace("\r\n", "\n"), TEMPLATE.read_text())
    for f in found:
        print("FAIL", f)
    print(f"check-pr-body: {len(found)} findings")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
