def applies(scope, path, standard, formal, technical, plaintext=False, svg=False):
    if svg:
        return scope == "svg"
    in_std = standard or "standards" in os.path.abspath(path).split(os.sep)[:-1]
    return (scope == "all" or (scope == "standard" and in_std)
            or (scope == "formal" and (in_std or formal))
            or (scope == "technical" and technical) or (scope == "plaintext" and plaintext))


def check_text(text, path, standard, formal, technical=False, plaintext=False, svg=False):
    raw = text.split("\n")
    lines = strip_code(raw)
    results = []
    for cid, kw, scope, what, fn, _, _ in CHECKS:
        # T5c is the S9a pattern, so a technical run reports a contraction once, as T5c.
        if cid == "S9a" and technical:
            continue
        if applies(scope, path, standard, formal, technical, plaintext, svg):
            results += [(cid, kw, what, n, t) for n, t in fn(lines, raw)]
    return results, None if svg else avg_len(lines)


def selftest():
    bad = plants = 0
    for cid, _, scope, what, _, hits, cleans in CHECKS:
        wrong = []
        tech, plain, vec = scope == "technical", scope == "plaintext", scope == "svg"
        std = not (tech or plain or vec)
        for text, want in [(h, True) for h in hits] + [(c, False) for c in cleans]:
            plants += 1
            got = any(r[0] == cid and r[2] == what
                      for r in check_text(text, "x.md", std, std, tech, plain, vec)[0])
            if got != want:
                wrong.append(f"{'missed' if want else 'flagged'} {text[:40]!r}")
        if wrong:
            print(f"PLANT FAIL  {cid} {what}: {'; '.join(wrong)}")
            bad = 1
        else:
            print(f"PLANT ok    {cid} {what} ({len(hits)} hit, {len(cleans)} clean)")
    # The standards path and the unknown option are not checks, so they are planted here.
    scope = [("a standards path turns on S7b", "docs/standards/x.md", "S7b", True),
             ("another path leaves it off", "docs/x.md", "S7b", False),
             ("a standards path leaves T5i off", "docs/standards/x.md", "T5i", False),
             ("a standards path leaves P3c off", "docs/standards/x.md", "P3c", False)]
    for what, path, cid, want in scope:
        plants += 1
        got = any(r[0] == cid for r in check_text("The writer must cite it; then\nstop.", path,
                                                  False, False)[0])
        print(f"PLANT {'ok  ' if got == want else 'FAIL'}  scope {what}")
        bad |= got != want
    plants += 1
    ids = [r[0] for r in check_text("It doesn't run.", "x.md", True, True, True)[0]]
    print(f"PLANT {'ok  ' if ids == ['T5c'] else 'FAIL'}  once a technical run reports a "
          "contraction once, as T5c")
    bad |= ids != ["T5c"]
    tall = plant_svg("", 'viewBox="0 0 100 200"')
    for what, text, vec, cid, want in [
            ("a Markdown run leaves the SVG checks off", tall, False, "D2g", False),
            ("an SVG run leaves the S checks off", tall.replace("></svg>", ">It doesn't run.</svg>"),
             True, "S9a", False)]:
        plants += 1
        got = any(r[0] == cid for r in check_text(text, "x.md", True, True, False, False, vec)[0])
        print(f"PLANT {'ok  ' if got == want else 'FAIL'}  scope {what}")
        bad |= got != want
    here = os.getcwd()
    with tempfile.TemporaryDirectory() as d, tempfile.TemporaryDirectory() as away:
        # Files are named relative to d, the working directory, since main() opens only
        # paths under it; the file in away is the planted path outside.
        os.chdir(d)
        with open("x.svg", "w", encoding="utf-8") as fh:
            fh.write("<svg><g></svg>")
        outside = os.path.join(away, "y.md")
        with open(outside, "w", encoding="utf-8") as fh:
            fh.write("Clean text.\n")
        for what, argv in [("an unknown option exits 2", ["--standrad", "x.md"]),
                           ("an SVG that does not parse exits 2", ["--svg", "x.svg"]),
                           ("a file outside the working directory exits 2", [outside])]:
            plants += 1
            err, sys.stderr = sys.stderr, open(os.devnull, "w")
            try:
                rc = main(argv)
            except SystemExit as e:
                rc = e.code
            sys.stderr.close()
            sys.stderr = err
            print(f"PLANT {'ok  ' if rc == 2 else 'FAIL'}  option {what}")
            bad |= rc != 2
        os.chdir(here)
    print(f"style-check selftest: {len(CHECKS)} checks, {plants} plants, "
          f"{'FAILED' if bad else 'all passed'}")
    return bad


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    unknown = [a for a in argv if a.startswith("--") and a not in FLAGS]
    if unknown:
        print(f"style-check: unknown option {unknown[0]}", file=sys.stderr)
        return 2
    standard, formal, technical = "--standard" in argv, "--formal" in argv, "--technical" in argv
    plaintext, vec = "--plaintext" in argv, "--svg" in argv
    files = [a for a in argv if not a.startswith("--")]
    if not files:
        print(__doc__.split("\n\n")[1])
        return 2
    fail = broken = 0
    for path in files:
        # Messages name the path as given; only the resolved one is opened.
        with open(under(os.getcwd(), path), encoding="utf-8") as fh:
            text = fh.read()
        if vec:
            try:
                svg_parse("\n".join(text.split("\n")))
            except expat.ExpatError as e:
                print(f"style-check: {path} does not parse as XML: {e}", file=sys.stderr)
                broken = 1
                continue
        results, avg = check_text(text, path, standard, formal, technical, plaintext, vec)
        for cid, kw, what, n, t in results:
            fail |= kw == "SHALL"
            print(f"{'FAIL' if kw == 'SHALL' else 'WARN'}  {path}:{n}  {cid} {what}: {t}")
        if avg is not None:
            print(f"INFO  {path}  S3h average sentence {avg:.1f} words")
    return 2 if broken else 1 if fail else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
