# Verification container, v2: every third-party checker the kit's checks call,
# so a check never reports a tool as not installed, and nothing is installed on
# the host. The tree goes in read-only and checks run with no network
# (containers/verify/verify). Built for linux/amd64 and linux/arm64.
#
# Every version below is exact. Every download is verified against a sha256,
# and pip installs only files whose hash is in requirements.txt. The version of
# each tool, and where it came from, is in containers/verify/README.md.

ARG TARGETARCH
FROM docker.io/library/python@sha256:2d44738ebf4ce5f63b9d9ea871e9c7cfdc0426f7b0c97cac915fd88ded1d86bb AS base

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends libmagic1 git xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Python checkers, each at an exact version. requirements.txt carries one hash
# per package, and pip refuses any package or dependency without one.
# reuse is built from its sdist with the backend pinned in
# build-requirements.txt, installed first, so no build step downloads anything
# unpinned.
COPY requirements.txt build-requirements.txt /tmp/
RUN pip install --no-cache-dir --require-hashes -r /tmp/build-requirements.txt \
 && pip install --no-cache-dir --require-hashes --no-build-isolation -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt /tmp/build-requirements.txt

# Downloads: one stage per architecture, one per line, each at an exact
# version and checked by digest. The build uses the stage named by
# TARGETARCH, which podman and docker set to the platform being built, and
# skips the other. The CodeQL bundle holds the CLI with the
# codeql/python-queries and codeql/actions-queries packs at the versions
# released with it, so no pack is downloaded at analysis time, when there is
# no network.
FROM scratch AS dl-amd64
ADD --checksum=sha256:64518dc413c8e7b5733fee2489e830a899bb1e3f28c8873b5869d5cc90164c5c https://github.com/github/codeql-action/releases/download/codeql-bundle-v2.27.3/codeql-bundle-linux64.tar.gz /tmp/dl/codeql.tar.gz
ADD --checksum=sha256:8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198 https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz /tmp/dl/shellcheck.tar.xz
ADD --checksum=sha256:8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8 https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz /tmp/dl/actionlint.tar.gz
ADD --checksum=sha256:a39b0c97695069d95d276d99be0f5dbabb081d801bfdc9ba49b76efaf94e2369 https://github.com/cue-lang/cue/releases/download/v0.17.1/cue_v0.17.1_linux_amd64.tar.gz /tmp/dl/cue.tar.gz

FROM scratch AS dl-arm64
ADD --checksum=sha256:0c9e32e9fcf65be4ab8df0cf0a7bb83e64aff4099fffc5f4930e84c12a454c8b https://github.com/github/codeql-action/releases/download/codeql-bundle-v2.27.3/codeql-bundle-linux-arm64.tar.gz /tmp/dl/codeql.tar.gz
ADD --checksum=sha256:12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588 https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.aarch64.tar.xz /tmp/dl/shellcheck.tar.xz
ADD --checksum=sha256:325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6 https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_arm64.tar.gz /tmp/dl/actionlint.tar.gz
ADD --checksum=sha256:0d729be30d52c952ca38fc9dcb692caa09d8463fa0b64df5781312779183fbcd https://github.com/cue-lang/cue/releases/download/v0.17.1/cue_v0.17.1_linux_arm64.tar.gz /tmp/dl/cue.tar.gz

FROM dl-${TARGETARCH} AS dl

FROM base
COPY --from=dl /tmp/dl /tmp/dl
RUN cd /tmp/dl \
 && tar -xzf codeql.tar.gz -C /opt && chmod -R a+rX /opt/codeql \
 && tar -xJf shellcheck.tar.xz && mv shellcheck-v0.11.0/shellcheck /usr/local/bin/ \
 && tar -xzf actionlint.tar.gz actionlint && mv actionlint /usr/local/bin/ \
 && tar -xzf cue.tar.gz cue && mv cue /usr/local/bin/ \
 && ln -s /opt/codeql/codeql /usr/local/bin/codeql \
 && cd / && rm -rf /tmp/dl

# Each tool must report the version pinned above, so a download that
# unpacks to a different release fails the build rather than the first check.
RUN codeql version --format=terse | grep -qx '2.27.3' \
 && shellcheck --version | grep -qx 'version: 0.11.0' \
 && actionlint -version | head -1 | grep -qx '1.7.12' \
 && cue version | head -1 | grep -qx 'cue version v0.17.1' \
 && reuse --version | grep -q '6.2.0' \
 && yamllint --version | grep -qx 'yamllint 1.38.0' \
 && check-jsonschema --version | grep -q '0.38.2' \
 && codeql resolve packs | grep -E 'codeql/(python|actions)-queries' > /opt/codeql-packs.txt

COPY codeql-scan /usr/local/bin/codeql-scan
RUN useradd -m -u 1000 check
USER check
WORKDIR /src
