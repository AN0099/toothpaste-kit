# Inside the verification image: CodeQL's python and actions analyses on the
# current directory, each with its pack's default query suite. Run through
# containers/verify/codeql, not by hand. Prints each alert as `file:line rule`
# and a count per language; exits 1 on any alert, 2 if an analysis fails.
set -eu
db=$(mktemp -d)
alerts=0
for lang in python actions; do
  codeql database create "$db/$lang" --language="$lang" --source-root=. \
    --threads=0 --quiet >&2 || exit 2
  codeql database analyze "$db/$lang" "codeql/$lang-queries" --format=sarif-latest \
    --output="$db/$lang.sarif" --threads=0 --ram=4096 --threat-model=local --quiet >&2 || exit 2
  n=$(python3 -I - "$db/$lang.sarif" <<'EOF_PY'
import json, sys
n = 0
for run in json.load(open(sys.argv[1]))['runs']:
    for r in run.get('results', []):
        loc = r['locations'][0]['physicalLocation']
        line = loc.get('region', {}).get('startLine', 0)
        print(f"{loc['artifactLocation']['uri']}:{line} {r['ruleId']}", file=sys.stderr)
        n += 1
print(n)
EOF_PY
) || exit 2
  printf 'codeql: %s: %s alert(s)\n' "$lang" "$n" >&2
  alerts=$((alerts + n))
done
[ "$alerts" -eq 0 ]
