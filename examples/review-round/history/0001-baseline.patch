+#!/usr/bin/env sh
+# Runs the built-in cases below against tally.py. Synthetic review material.
+set -u
+if [ "${1:-}" != "--selftest" ]; then
+    echo "usage: check.sh --selftest" >&2
+    exit 2
+fi
+dir=$(dirname "$0")
+tmp=$(mktemp)
+trap 'rm -f "$tmp"' EXIT
+failed=0
+run() {
+    expected=$1; shift
+    printf '%s' "$1" > "$tmp"; shift
+    got=$(python3 "$dir/tally.py" "$@" "$tmp")
+    if [ "$got" != "$expected" ]; then
+        echo "case failed: expected $expected, got $got"
+        failed=1
+    fi
+}
+run 0 ''
+run 1 'one'
+run 3 'one two  three'
+run 2 'tab	separated'
+[ "$failed" -eq 0 ] && echo "check: 4 cases passed"
+exit "$failed"
