+"""Count the words in a file. Synthetic review material."""
+import sys
+
+
+def words(text):
+    return len(text.split())
+
+
+def main(argv):
+    if len(argv) != 1:
+        print("usage: tally.py FILE", file=sys.stderr)
+        return 2
+    with open(argv[0], encoding="utf-8") as f:
+        print(words(f.read()))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
